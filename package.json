{
  "name": "career-ops",
  "version": "1.6.0",
  "description": "Model-agnostic job search evaluation and tracking runtime",
  "scripts": {
    "test": "node test-all.mjs --quick",
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "liveness:bulk": "node liveness-parallel.mjs",
    "liveness:batch": "node liveness-parallel.mjs --from-batch",
    "scan": "node scan.mjs",
    "scan:spa": "node scan-spa.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "runtime:test": "node --test tests/runtime-*.test.mjs",
    "runtime:doctor": "node bin/career-ops.mjs doctor --config config/runtime.example.yml",
    "runtime:label-pack": "node scripts/build-runtime-label-review.mjs --target ft",
    "runtime:split-label-pack": "node scripts/build-runtime-split-label-review.mjs --target ft",
    "runtime:historical-fixtures": "node scripts/build-runtime-historical-fixtures.mjs --target ft --replace",
    "runtime:reinterpret-history": "node scripts/reinterpret-runtime-historical-shadow.mjs",
    "runtime:historical-evidence": "node scripts/capture-runtime-historical-evidence.mjs --target ft --apply",
    "runtime:replacement-pack": "node scripts/build-runtime-replacement-review.mjs --target ft"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1"
  },
  "devDependencies": {
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rebrowser-playwright": "^1.52.0"
  },
  "bin": {
    "career-ops": "bin/career-ops.mjs"
  }
}
