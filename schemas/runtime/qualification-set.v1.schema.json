{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeQualificationSetV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "evaluation_set_version", "representative",
    "truth_source", "label_scope", "gate_labels_included", "promotion_eligible",
    "promotion_blockers", "case_count", "task_class", "risk",
    "minimum_capability_class", "scenarios"
  ],
  "properties": {
    "schema": { "const": "RuntimeQualificationSetV1" },
    "schema_version": { "type": "integer", "const": 1 },
    "evaluation_set_version": { "type": "string", "minLength": 1 },
    "representative": { "type": "boolean", "const": false },
    "truth_source": { "const": "DETERMINISTIC_ORACLE" },
    "label_scope": {
      "type": "array",
      "prefixItems": [{ "const": "hard_gates" }, { "const": "policy_decision" }],
      "items": false
    },
    "gate_labels_included": { "type": "boolean", "const": true },
    "promotion_eligible": { "type": "boolean", "const": false },
    "promotion_blockers": {
      "type": "array",
      "contains": { "const": "SYNTHETIC_NON_REPRESENTATIVE" }
    },
    "case_count": { "type": "integer", "minimum": 50 },
    "task_class": { "const": "job_evaluation" },
    "risk": { "type": "string" },
    "minimum_capability_class": { "type": "string" },
    "scenarios": { "type": "array", "minItems": 1 }
  }
}
