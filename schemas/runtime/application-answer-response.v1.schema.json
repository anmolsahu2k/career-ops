{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.local/schemas/runtime/application-answer-response.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["answers"],
  "properties": {
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "text", "evidence_ids", "confidence", "claims_validated"],
        "properties": {
          "field_id": {"type": "string"}, "text": {"type": "string", "maxLength": 4000},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "claims_validated": {"type": "boolean"}
        }
      }
    }
  }
}
