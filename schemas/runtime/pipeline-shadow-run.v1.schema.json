{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.local/schemas/runtime/pipeline-shadow-run.v1.schema.json",
  "title": "PipelineShadowRunV1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "schema_version", "mode", "profile_id", "non_mutating", "projected", "actual", "variance"],
  "properties": {
    "schema": { "const": "PipelineShadowRunV1" },
    "schema_version": { "const": 1 },
    "mode": { "enum": ["PLAN_ONLY", "EXECUTED"] },
    "profile_id": { "type": "string", "minLength": 1 },
    "non_mutating": { "const": true },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "provider_id", "case_count", "usage", "cases"],
        "properties": {
          "stage": { "enum": ["triage", "judgment", "escalation"] },
          "provider_id": { "type": "string" },
          "case_count": { "type": "integer", "minimum": 0 },
          "usage": { "$ref": "#/$defs/usage" },
          "cases": { "type": "array" }
        }
      }
    },
    "projected": { "type": "object" },
    "actual": { "type": ["object", "null"] },
    "variance": { "type": ["object", "null"] }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "reasoning_tokens", "thinking_tokens", "cache_read_tokens", "total_tokens", "measurement_quality"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "thinking_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "measurement_quality": { "enum": ["EXACT_COMPONENTS", "REPORTED_TOTAL_ONLY", "PARTIAL_COMPONENTS", "UNAVAILABLE"] }
      }
    }
  }
}
