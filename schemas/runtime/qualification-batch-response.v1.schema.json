{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.local/schemas/runtime/qualification-batch-response.v1.schema.json",
  "title": "Career-Ops Qualification Batch Response V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluations"],
  "properties": {
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "response"],
        "properties": {
          "case_id": { "type": "string" },
          "response": { "$ref": "#/$defs/providerResponse" }
        }
      }
    }
  },
  "$defs": {
    "providerResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_inputs", "presentation_content"],
      "properties": {
        "decision_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gates", "score", "recommendation", "confidence"],
          "properties": {
            "gates": {
              "type": "object",
              "additionalProperties": false,
              "required": ["posting_live", "citizenship_restricted", "geography_eligible", "sponsorship_compatible", "required_evidence_complete"],
              "properties": {
                "posting_live": { "$ref": "#/$defs/gate" },
                "citizenship_restricted": { "$ref": "#/$defs/gate" },
                "geography_eligible": { "$ref": "#/$defs/gate" },
                "sponsorship_compatible": { "$ref": "#/$defs/gate" },
                "required_evidence_complete": { "$ref": "#/$defs/gate" }
              }
            },
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
            "recommendation": { "enum": ["APPLY", "CONSIDER", "DO_NOT_APPLY", "REVIEW_REQUIRED"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "presentation_content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C", "D", "E", "F", "G"],
          "properties": {
            "A": { "$ref": "#/$defs/plainText" },
            "B": { "$ref": "#/$defs/plainText" },
            "C": { "$ref": "#/$defs/plainText" },
            "D": { "$ref": "#/$defs/plainText" },
            "E": { "$ref": "#/$defs/plainText" },
            "F": { "$ref": "#/$defs/plainText" },
            "G": { "$ref": "#/$defs/plainText" }
          }
        }
      }
    },
    "plainText": { "type": "string", "minLength": 1, "maxLength": 320 },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_refs"],
      "properties": {
        "value": { "enum": ["YES", "NO", "UNKNOWN"] },
        "evidence_refs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "field", "span_hash"],
            "properties": {
              "evidence_id": { "type": "string" },
              "field": { "type": ["string", "null"] },
              "span_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
