# Personal data — NOT tracked (untracked + scrubbed from git history 2026-05-20).
# Upstream santifer/career-ops already ignores most of these; this fork briefly
# committed them so the (now-decommissioned) cloud routines could read them.
# Routines are gone, so these stay personal-only and out of git.
cv.md
portals.yml
config/profile.yml
data/
reports/
resumes/
faculty_emails/
interview-prep/
prep/
housing/
portfolio/
STATUS.md
CHANGELOG.md
INDEX.md
# (config/profile.example.yml stays tracked — it is a template, not personal.)

# Truly transient stuff that should never be committed
data/.liveness-urls-*.txt
data/applications.md.bak
data/pipeline.md
data/scan-history.tsv
data/cron-stdout.log
data/daily-scan-*.log
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep
# Writing samples (user's personal files, never committed)
writing-samples/*
!writing-samples/README.md

.update-dismissed
.update-lock

# Sensitive: copy of the workspace-root work-experience honesty file (never to GitHub)
# (lives at workspace root, not under career-ops/, so this is belt-and-suspenders)
**/Work\ experience-Project\ based*.md

# User profile customization stays gitignored — it has narrative weighting
# that's iterative; keep it local.
modes/_profile.md

# Python bytecode
__pycache__/
*.pyc

# Secrets (never commit — use .env.example as template)
.env

# Generated
.resolved-prompt-*
node_modules/
bun.lock

